{
  "config": {
    "step": {
      "user": {
        "title": "Add a hackerspace",
        "description": "Search the SpaceAPI directory (directory.spaceapi.io) by name, or enter the URL of a SpaceAPI endpoint directly.",
        "data": {
          "search": "Search",
          "url": "SpaceAPI URL"
        },
        "data_description": {
          "search": "Part of the space name, e.g. \"chaos\". Case does not matter.",
          "url": "Optional: your own endpoint URL. Takes precedence over the search."
        }
      },
      "select": {
        "title": "Choose a space",
        "description": "{count} spaces match \"{search}\".",
        "data": {
          "space": "Space"
        }
      }
    },
    "error": {
      "no_match": "No space in the directory matches this search.",
      "missing_input": "Enter a search term or a URL.",
      "invalid_url": "This is not a valid http(s) URL.",
      "directory_unavailable": "The SpaceAPI directory could not be loaded. Try again later or enter the URL directly.",
      "cannot_connect": "The SpaceAPI endpoint could not be reached.",
      "invalid_api": "The URL does not return a valid SpaceAPI document (field \"space\" missing)."
    },
    "abort": {
      "already_configured": "This space is already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "SpaceAPI options",
        "data": {
          "scan_interval": "Update interval"
        },
        "data_description": {
          "scan_interval": "How often the endpoint is polled, in minutes."
        }
      }
    }
  },
  "exceptions": {
    "cannot_connect": {
      "message": "Error fetching {url}: {error}"
    },
    "invalid_response": {
      "message": "Invalid SpaceAPI response from {url}: {error}"
    }
  },
